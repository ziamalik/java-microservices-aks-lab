{
    "image": "mcr.microsoft.com/devcontainers/java:17-bookworm",
    "containerEnv": {
        "JAVA_HOME": "/usr/lib/jvm/msopenjdk-current"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "vscjava.vscode-java-pack",
                "ms-azuretools.vscode-docker",
                "ms-azuretools.vscode-azureterraform"
            ]
        }
    },
    // This command cleans the broken Yarn repo and installs Docker/Terraform manually
    "postCreateCommand": "sudo rm -f /etc/apt/sources.list.d/yarn.list && sudo apt-get update && sudo apt-get install -y docker.io terraform",
    "remoteUser": "vscode"
}